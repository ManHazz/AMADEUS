# Copy to .env and adjust. All values optional — these are the defaults.

# --- brain (any OpenAI-compatible chat endpoint; llama.cpp --jinja works) ---
BRAIN_URL=http://127.0.0.1:8081/v1
BRAIN_MODEL=local-model
BRAIN_MAX_TOKENS=220
HISTORY_TURNS=8

# each browser session (page load) gets its own conversation, isolated from
# every other session; one idle longer than this is evicted to free memory
SESSION_TTL_SECONDS=3600

# --- speech-to-text (faster-whisper) ---
STT_DEVICE=cpu            # cpu | cuda
STT_MODEL=small           # tiny | base | small | medium | large-v3 (medium = better Japanese)
STT_LANGUAGE=en           # en | ja | auto (auto/empty = Whisper detects; use for mixed EN/JA tutoring)
STT_INITIAL_PROMPT=       # optional bias text, e.g. "Japanese lesson. こんにちは。"
STT_VAD=1                 # 1 = voice-activity filter on

# --- text-to-speech (Kokoro) ---
TTS_DEVICE=cpu            # cpu | cuda
TTS_VOICE=af_heart        # af_bella, am_michael, bf_emma, ...
TTS_LANG=a                # a=American English, b=British, ...
TTS_VOICE_JA=jf_alpha     # Japanese voice for [ja] lines: jf_alpha|jf_nezumi|jf_tebukuro|jf_gongitsune
TTS_JA_WARMUP=1           # 1 = load the Japanese Kokoro pipeline at startup (else lazily)

# --- feature flags ---
ENABLE_WEB_SEARCH=1       # 0 = chat_agent only (no web tools, fastest)

# --- auth: shared secret; injected into the page at serve time ---
# leave unset and the server prints a random one at startup
VOICE_AGENT_TOKEN=

# --- server ---
PORT=5000

# 1: English lines are shown as silent tips, only Japanese is spoken
ENGLISH_FREE=1

# --- system prompt ---
# Load order: SYSTEM_PROMPT_FILE, then SYSTEM_PROMPT, then the bundled prompts/tutor_neutral.txt
# (a neutral Japanese tutor prompt that identifies itself as an AI tutor, with no persona name).
#SYSTEM_PROMPT_FILE=prompts/tutor_neutral.txt
#SYSTEM_PROMPT=

# --- brain API key (only for hosted providers such as Gemini via its OpenAI-compatible endpoint) ---
#BRAIN_API_KEY=
